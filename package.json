{
  "name": "homebridge-christie-projector",
  "version": "1.0.3",
  "description": "Homebridge dynamic platform plugin for Christie Digital projectors over Ethernet TCP/IP (Port 3002).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremylatrasse/homebridge-christie-projector.git"
  },
  "bugs": {
    "url": "https://github.com/jeremylatrasse/homebridge-christie-projector/issues"
  },
  "homepage": "https://github.com/jeremylatrasse/homebridge-christie-projector#readme",
  "keywords": [
    "homebridge-plugin",
    "christie",
    "christie-digital",
    "projector",
    "cinema",
    "home-theater",
    "griffyn",
    "eclipse",
    "m-series",
    "j-series",
    "hs-series",
    "crimson",
    "boxer"
  ],
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=1.6.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "compile": "tsc",
    "watch": "tsc --watch",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "npm run compile && node test-christie.mjs",
    "bump": "npm version patch --no-git-tag-version",
    "release": "npm run bump && npm run compile && node test-christie.mjs",
    "hooks": "make hooks 2>/dev/null || true",
    "prepublishOnly": "npm run clean && npm run compile"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.12.0",
    "homebridge": "^1.8.0",
    "typescript": "^5.4.0"
  }
}
